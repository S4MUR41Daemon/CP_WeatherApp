<?xml version="1.0" encoding="utf-8"?>
<!-- Marco neón del widget: resplandor exterior (secundario) + línea nítida (primario) + fondo casi negro. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E6070606" />
            <stroke android:width="5dp" android:color="#33B3001B" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#66B3001B" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#FFE9E2D3" />
        </shape>
    </item>
    <!-- Esquina superior izquierda reforzada -->
    <item android:gravity="top|left" android:left="3dp" android:top="3dp" android:width="26dp" android:height="4dp">
        <shape android:shape="rectangle"><solid android:color="#FFE9E2D3" /></shape>
    </item>
    <item android:gravity="top|left" android:left="3dp" android:top="3dp" android:width="4dp" android:height="26dp">
        <shape android:shape="rectangle"><solid android:color="#FFE9E2D3" /></shape>
    </item>
    <!-- Esquina inferior derecha en rojo -->
    <item android:gravity="bottom|right" android:right="3dp" android:bottom="3dp" android:width="26dp" android:height="4dp">
        <shape android:shape="rectangle"><solid android:color="#FFB3001B" /></shape>
    </item>
    <item android:gravity="bottom|right" android:right="3dp" android:bottom="3dp" android:width="4dp" android:height="26dp">
        <shape android:shape="rectangle"><solid android:color="#FFB3001B" /></shape>
    </item>
</layer-list>
